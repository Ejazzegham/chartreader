# Files that must never be uploaded with the app build (EAS uses this file INSTEAD of .gitignore when it exists)
node_modules/
.expo/
dist/
*.apk
*.aab
*.zip
.env
# the server and its database (user emails, session secret) are not part of the app
server/
tests/

# email page + Firebase email templates: hosted separately (firebase deploy --only hosting), not part of the app build
auth-page/
firebase-templates/
firebase.json
.firebaserc
